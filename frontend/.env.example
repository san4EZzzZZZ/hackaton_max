# Base URL of the DATA-API. Relative "/api" works out of the box in dev thanks to the
# Vite proxy; set an absolute URL when the Mini App is served separately from the backend.
VITE_API_URL=/api/v1
# Where the Vite dev proxy forwards /api (backend FastAPI app).
VITE_BACKEND_URL=http://127.0.0.1:8080
