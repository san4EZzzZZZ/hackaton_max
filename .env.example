# --- MAX bot credentials ---------------------------------------------------
# Raw token from business.max.ru -> Чат-боты -> Настройки (no "Bearer" prefix)
BOT_TOKEN=
BOT_API_URL=https://platform-api2.max.ru
BOT_USER_ID=
BOT_USERNAME=
BOT_NAME=Хакатон МАХ 91

# --- Mini App --------------------------------------------------------------
# URL of the Mini App bound to the bot; used by the open_app button.
# When empty, the button falls back to the https://max.ru/<BOT_USERNAME>?startapp= deep link.
MINI_APP_URL=
# Public HTTPS base URL of this service, e.g. https://bot.example.com
PUBLIC_BASE_URL=
BOT_WEBHOOK_URL=
# 5-256 chars; MAX echoes it back in the X-Max-Bot-Api-Secret header of every delivery
WEBHOOK_SECRET=

# --- HTTP server -----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- Storage ---------------------------------------------------------------
# SQLite for the MVP; switch to Postgres by changing only this value:
# DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/maxbot
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- TLS -------------------------------------------------------------------
# MAX serves a chain rooted in the Russian Ministry of Digital Development CA (НУЦ Госуслуг),
# which no default trust store contains. The root ships in certs/ — it is loaded on top of the
# certifi roots, so verification stays strict. Point this at your own file to override.
SSL_CA_BUNDLE=certs/russian-trusted-root-ca.pem
# Never set to false outside local debugging
SSL_VERIFY=true

# --- Runtime ---------------------------------------------------------------
LOG_LEVEL=INFO
# Register bot commands menu and (in webhook mode) the subscription on startup
AUTO_SETUP=true
POLLING_TIMEOUT=30
POLLING_LIMIT=100
HTTP_TIMEOUT=30

# --- Автокаталог: поиск мест по городам (python -m ingest / POST /api/v1/admin/ingest) -----
# Token for the admin endpoints, sent back in the X-Ingest-Token header. Empty turns the endpoints
# off with a 503 — they are the only way to rewrite the catalog over HTTP.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Nominatim and Overpass both require an identifying User-Agent with a reachable address; a generic
# one gets 403 at Nominatim and is deprioritised at Overpass.
INGEST_USER_AGENT=MAXNavigatorBot/1.0 (https://max.chestnyidiplom.ru)
# Seconds to idle between requests to the same host. Nominatim's policy is one per second, but
# Overpass runs a per-IP queue and starts refusing connections well before that; lowering this
# trades a faster pass for a city with three of its categories missing.
INGEST_REQUEST_GAP=5
# A whole city pass is one heavy query per category, so it waits far longer than the bot's 30s.
INGEST_TIMEOUT=180
INGEST_MAX_PLACES_PER_CITY=60
INGEST_MAX_PER_CATEGORY=12
# Public endpoints, all overridable. `overpass-api.de` refuses connections from an IP it has
# throttled (measured: TCP connect fails for a while after a heavy pass); mirrors answer the same
# data, and maps.mail.ru was the one reachable from a Russian network:
#   OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
# NOMINATIM_URL / WIKIDATA_SPARQL_URL / COMMONS_API_URL default to the canonical services.
# Cities that `--all` walks.
INGEST_CITIES_FILE=data/cities.json
